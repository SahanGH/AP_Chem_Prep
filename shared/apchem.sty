%% apchem.sty -- shared core for AP Chemistry materials
%% Phase 0 infrastructure. Loaded by apchem-notes/worksheet/exam classes.
%%
%% TWO BUILD TOGGLES, set by \def before \input (see build.ps1):
%%   \ISKEY  defined -> teacher key   (answers shown)
%%   \ISLMS  defined -> screen/LMS    (tighter blanks, live links, no punch gutter)
%% Undefined = student, print. Four PDFs from one source.
%%
%% Layout invariant: answer blanks occupy the SAME width/height in student and
%% key builds, so page breaks never drift between the two copies.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{apchem}[2026/08/08 v1.0 AP Chemistry shared macros]

\RequirePackage{etoolbox}

\newtoggle{apcKey}
\newtoggle{apcLMS}
\ifcsname ISKEY\endcsname\toggletrue{apcKey}\fi
\ifcsname ISLMS\endcsname\toggletrue{apcLMS}\fi

% ---------------------------------------------------------------- page setup
% Print is duplex-bound: TWOSIDE with the binder gutter on the INNER edge
% (left of odd pages, right of even pages), so punched holes always land on
% the binding side. LMS is on-screen: symmetric margins, oneside.
\iftoggle{apcLMS}{%
  \RequirePackage[letterpaper,top=0.8in,bottom=0.85in,left=0.85in,right=0.85in]{geometry}%
}{%
  \RequirePackage[letterpaper,twoside,top=0.85in,bottom=0.9in,inner=1.2in,outer=0.7in]{geometry}%
}

