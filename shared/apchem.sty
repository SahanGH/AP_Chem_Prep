% ------------------------------------------------------------ answer blanks
% A last-resort line break before an \answerblank.
%
% The blank is a fixed-width \makebox and cannot be broken or shrunk. When it
% does not fit in what is left of the line, TeX's only alternative is to break
% at the preceding space -- but that leaves a very loose line whose badness
% exceeds \tolerance, so TeX rejects it and emits an OVERFULL box instead: the
% blank, and the key's answer inside it, run off the right edge of the page and
% are clipped. That silently damaged 37 paragraphs across the corpus before it
% was caught by reading a built PDF.
%
% The fil pair makes the break legal AND cheap when it is taken: the two glues
% cancel exactly (0pt natural, +1fil and -1fil stretch) when no break occurs, so
% the inline footprint is untouched; when the break IS taken at the penalty, the
% first fil fills out the short line (badness 0) and the negative fil is
% discarded after the break.
%
% The penalty must be 9999, not 0. At 0 the break is free, so TeX prefers it and
% every narrow inline blank jumps to its own line, reflowing the whole corpus.
% At 9999 the demerits are enormous and TeX takes it only when the alternative
% is an overfull box -- which is exactly the case we are fixing.
\newcommand{\apc@blankbreak}{%
  \hskip 0pt plus 1fil\relax\penalty 9999 \hskip 0pt plus -1fil\relax
}

% \answerblank[width]{answer} -- inline fill-in.
% Identical footprint in both builds so line breaking never shifts.
% The key's answer is set in a \makebox of the DECLARED width. If the answer is
% wider than that, \makebox does not complain -- the text simply spills out of
% the box and lands on top of whatever follows it. Nothing in the build fails
% and the log stays silent; the only symptom is overprinted text in the key.
%
% So measure the answer once, into a box we then reuse for typesetting (reusing
% it rather than re-expanding #2 keeps the content from being executed twice),
% and warn with the exact shortfall. Widths are only checked in the key build
% because the student build's blank is empty -- but the footprint invariant
% makes the two widths identical, so checking the key checks both.
\newsavebox{\apc@ansmeasure}
\newlength{\apc@ansover}
\newcommand{\answerblank}[2][4cm]{%
  \apc@blankbreak
  \iftoggle{apcKey}{%
    \sbox{\apc@ansmeasure}{\color{apcans}\bfseries #2}%
    \setlength{\apc@ansover}{\wd\apc@ansmeasure}%
    \addtolength{\apc@ansover}{-#1}%
    \ifdim\apc@ansover>\z@
      \PackageWarning{apchem}{%
        answerblank OVERFLOW by \the\apc@ansover\space (declared #1)%
      }%
    \fi
    \underline{\makebox[#1][l]{\usebox{\apc@ansmeasure}}}%
  }{%
    \underline{\makebox[#1]{\rule{0pt}{1.15em}}}%
  }%
}

% \answerlines[n]{answer} -- n ruled lines of writing space.
% LMS build shrinks the line count (typing is denser than handwriting).
%
% Footprint invariant: the key's answer box is usually SHORTER than the n
% ruled lines it replaces, which silently drifts pagination between the two
% builds. So measure the box and pad it up to the student height. Padding
% only -- a long answer is never clipped, it just grows past the target.
\newsavebox{\apc@ansbox}
\newlength{\apc@anstarget}
\newlength{\apc@ansgap}
\newcommand{\answerlines}[2][3]{%
  \par\nopagebreak\vspace{0.35em}%
  \iftoggle{apcKey}{%
    % Reserve exactly the height the student's ruled lines would occupy, so
    % the two builds paginate identically. A fixed-height minipage is exact
    % by construction -- no \vspace to be swallowed or discarded at a break.
    % Height is max(natural, target), so a long answer grows instead of
    % being clipped.
    % Cost of ONE student ruled line: the \vspace after it, plus \parskip
    % (each rule is its own paragraph), plus a full \baselineskip -- TeX
    % advances a whole baseline for the rule's line box, not merely its
    % 0.4pt height. Omitting the baselineskip term was leaving the key
    % about 15% short per line, which compounded to 3 pages on Unit 4.
    \setlength{\apc@anstarget}{#1\dimexpr 1.6em+\parskip+\baselineskip\relax}%
    \sbox{\apc@ansbox}{\begin{minipage}{\linewidth}%
      \begin{apcanswerfixed}#2\end{apcanswerfixed}%
    \end{minipage}}%
    \setlength{\apc@ansgap}{\dimexpr\ht\apc@ansbox+\dp\apc@ansbox\relax}%
    \ifdim\apc@ansgap<\apc@anstarget
      \setlength{\apc@ansgap}{\apc@anstarget}%
    \fi
    \noindent\begin{minipage}[t][\apc@ansgap][t]{\linewidth}%
      \usebox{\apc@ansbox}%
    \end{minipage}\par
  }{%
    \iftoggle{apcLMS}{\def\apc@n{1}}{\def\apc@n{#1}}%
    \foreach \apc@i in {1,...,\apc@n}{%
      \noindent\textcolor{apcrule}{\rule{\linewidth}{0.4pt}}\par\vspace{1.6em}%
    }%
  }%
  \vspace{0.2em}%
}

% \workspace[height] -- blank calculation space, print only gets the full box.
\newcommand{\workspace}[1][3cm]{%
  \par\vspace{0.3em}%
  \iftoggle{apcLMS}{\vspace{0.8cm}}{\vspace{#1}}%
  \par%
}

\newtcolorbox{apcanswer}{
  enhanced, breakable,
  colback=apcansbg, colframe=apcans,
  boxrule=0.9pt, left=6pt, right=6pt, top=4pt, bottom=4pt,
  fontupper=\color{apcans}\bfseries,
  before skip=4pt, after skip=6pt,
}

% Non-breakable twin, used inside \answerlines' measuring \sbox -- a
% breakable tcolorbox cannot be measured in a save box.
\newtcolorbox{apcanswerfixed}{
  enhanced, breakable=false,
  colback=apcansbg, colframe=apcans,
  boxrule=0.9pt, left=6pt, right=6pt, top=4pt, bottom=4pt,
  fontupper=\color{apcans}\bfseries,
  before skip=4pt, after skip=6pt,
}

% ---------------------------------------------------------------- CED tagging
% Every item is traceable to the framework and the textbook.
\newcommand{\ced}[1]{%
  \tikz[baseline=(n.base)]{\node[fill=apcbanner,text=apcbannertext,rounded corners=2pt,
    inner xsep=4pt,inner ysep=1.5pt,font=\sffamily\bfseries\scriptsize] (n) {CED #1};}%
}
\newcommand{\practice}[1]{%
  \tikz[baseline=(n.base)]{\node[draw=apcgray,text=apcgray,rounded corners=2pt,
    inner xsep=4pt,inner ysep=1.2pt,font=\sffamily\scriptsize] (n) {SP #1};}%
}
% \zsec{2.8} -- textbook-section tag for Chapters\ materials. Distinct from
% \ced so a chapter section number is never mistaken for a CED topic code.
\newcommand{\zsec}[1]{%
  \tikz[baseline=(n.base)]{\node[draw=apcaccent,line width=0.7pt,text=apcaccent,
    rounded corners=2pt,inner xsep=4pt,inner ysep=1.5pt,
    font=\sffamily\bfseries\scriptsize] (n) {ZUM \S#1};}%
}
% \zref{section}{pdf page range} -- Zumdahl citation, always by page range.
\newcommand{\zref}[2]{%
  {\sffamily\footnotesize\color{apcgray}Zumdahl #1\,\textbullet\,pp.~#2}%
}

\newcommand{\term}[1]{\textbf{\color{apcaccent}#1}}

