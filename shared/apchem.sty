\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\sffamily\footnotesize\color{apcaccent}%
  AP Chemistry\ \textbullet\ \apc@unitword\ \apc@unit: \apc@unittitle}
\fancyhead[R]{\sffamily\footnotesize\color{apcaccent}%
  \iftoggle{apcKey}{\bfseries\color{apcans}\apcvariant}{\apc@doctitle}}
% Footers mirror in twoside print: Name at the inner (bound) edge, page
% number at the outer edge where a flipping thumb finds it. In oneside (LMS)
% only the O selectors fire, reproducing the old left/right layout.
\fancyfoot[LO,RE]{\sffamily\footnotesize\color{apcgray}Name:~\rule{4.5cm}{0.4pt}}
\fancyfoot[RO,LE]{\sffamily\footnotesize\color{apcgray}\thepage}

% Print keys carry a standing reminder so a stray copy is never mistaken for a
% student handout mid-class.
\iftoggle{apcKey}{%
  \RequirePackage{background}%
  \backgroundsetup{scale=1,angle=45,opacity=0.06,
    contents={\sffamily\bfseries\Huge TEACHER KEY}}%
}{}

\newcommand{\apctitleblock}{%
  \thispagestyle{fancy}%
  \begin{tcolorbox}[enhanced,colback=apclight,colframe=apcaccent,boxrule=1pt,
      left=10pt,right=10pt,top=8pt,bottom=8pt,arc=3pt]
    {\sffamily\bfseries\Large\color{apcaccent} \apc@unitword\ \apc@unit\ \textbullet\ \apc@unittitle}\\[2pt]
    {\sffamily\LARGE\bfseries \apc@doctitle}%
    \ifdefempty{\apc@subtitle}{}{\\[3pt]{\sffamily\normalsize\color{apcgray}\apc@subtitle}}%
    \keyonly{\\[4pt]{\sffamily\bfseries\normalsize\color{apcans}TEACHER KEY --- answers
      \iftoggle{apcLMS}{shown in red}{shown bold in answer boxes}}}%
  \end{tcolorbox}%
  \vspace{0.4em}%
}

% ------------------------------------------------------------ shared elements
% Retrieval warm-up. Monday gets 4 items (3-day gap), Wed/Fri get 3.
\newenvironment{warmup}[1][3]{%
  \needspace{4\baselineskip}%
  \begin{tcolorbox}[enhanced,breakable,colback=white,colframe=apcaccent,
    boxrule=0.9pt,left=6pt,right=6pt,top=4pt,bottom=4pt,
    title={\sffamily\bfseries\small RETRIEVAL WARM-UP \textbullet\ 5 min \textbullet\ #1 items},
    coltitle=apcbannertext,colbacktitle=apcbanner]%
  \begin{enumerate}[leftmargin=*,itemsep=0.4em,topsep=2pt]%
}{%
  \end{enumerate}\end{tcolorbox}\vspace{0.3em}%
}

\newenvironment{exitticket}{%
  \needspace{4\baselineskip}%
  \begin{tcolorbox}[enhanced,breakable,colback=apclight,colframe=apcaccent,
    boxrule=0.9pt,left=6pt,right=6pt,top=4pt,bottom=4pt,
