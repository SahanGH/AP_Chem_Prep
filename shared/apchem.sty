% designed grays beat color-converted-to-mud. Answers are distinguished by
% weight, underline, and boxes -- never by hue alone. LMS builds get color.
% Banner colors are semantic: every titled box and section header draws from
% these, so the print/LMS distinction lives here and nowhere else.
%   LMS   -- colored fills, white text
%   print -- light gray fills one step darker than minor headings (F2F2F2),
%            BLACK text; no heavy toner fields anywhere
\iftoggle{apcLMS}{%
  \definecolor{apcaccent}{HTML}{1F4E79}% headers, structural rules
  \definecolor{apcans}{HTML}{9E2A2B}   % key answers
  \definecolor{apcansbg}{HTML}{FBEFEF}
  \definecolor{apcgray}{HTML}{5A5A5A}
  \definecolor{apclight}{HTML}{EEF3F8}
  \definecolor{apcrule}{HTML}{BFC9D4}
  \definecolor{apcwarn}{HTML}{8A6D1F}
  \definecolor{apcwarnbg}{HTML}{FDF6E3}
  \definecolor{apcbanner}{HTML}{1F4E79}    % accent-role banner fill
  \definecolor{apcbannergray}{HTML}{5A5A5A}% gray-role banner fill
  \definecolor{apcbannerwarn}{HTML}{8A6D1F}% trap banner fill
  \definecolor{apcbannerans}{HTML}{9E2A2B} % rubric banner fill
  \definecolor{apcbannertext}{HTML}{FFFFFF}
}{%
  \definecolor{apcaccent}{HTML}{2B2B2B}
  \definecolor{apcans}{HTML}{000000}   % answers: black + bold + box/underline
  \definecolor{apcansbg}{HTML}{EFEFEF}
  \definecolor{apcgray}{HTML}{4D4D4D}
  \definecolor{apclight}{HTML}{F2F2F2} % minor headings / segment strips
  \definecolor{apcrule}{HTML}{B3B3B3}
  \definecolor{apcwarn}{HTML}{4D4D4D}
  \definecolor{apcwarnbg}{HTML}{F2F2F2}
  \definecolor{apcbanner}{HTML}{D9D9D9}    % one step darker than apclight
  \definecolor{apcbannergray}{HTML}{D9D9D9}
  \definecolor{apcbannerwarn}{HTML}{D9D9D9}
  \definecolor{apcbannerans}{HTML}{D9D9D9}
  \definecolor{apcbannertext}{HTML}{000000}
}

