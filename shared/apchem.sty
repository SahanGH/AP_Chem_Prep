% Semantic plot styles: multi-series plots MUST use these, never raw colors.
% LMS separates series by hue; print separates them by dash pattern, so a B&W
% copy of two curves stays readable.
\iftoggle{apcLMS}{%
  \tikzset{
    seriesA/.style={color=apcaccent, thick},
    seriesB/.style={color=apcans, thick},
    seriesC/.style={color=apcwarn, thick},
  }%
}{%
  \tikzset{
    seriesA/.style={color=black, thick},
    seriesB/.style={color=black, thick, dashed},
    seriesC/.style={color=black, thick, dotted},
  }%
}

